# SMTP-настройки для отправки заполненных анкет на почту.
# Скопируйте этот файл в .env.local и заполните значения (файл .env.local в Git не попадает).
# На Vercel эти же переменные добавьте в Project Settings → Environment Variables.

# Куда приходят анкеты (по умолчанию anka.freedom@gmail.com)
MAIL_TO=anka.freedom@gmail.com

# SMTP-сервер. Пример для Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Логин SMTP — почта, с которой отправляются письма
SMTP_USER=anka.freedom@gmail.com
# Пароль приложения (App Password), НЕ обычный пароль от почты.
# Как получить для Gmail: включить 2FA → https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password

# Необязательно: адрес в поле "От кого" (по умолчанию = SMTP_USER)
MAIL_FROM=anka.freedom@gmail.com
